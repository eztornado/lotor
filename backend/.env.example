# API Configuration
API_V1_STR="/api/v1"
PROJECT_NAME="LoTor API"
VERSION="1.0.0"

# Server
HOST="0.0.0.0"
PORT=8000
DEBUG=True

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Database
DATABASE_URL="sqlite:///./lotor.db"

# ML Models
MODELS_PATH="./app/ml/models"
MAX_HISTORY_LENGTH=52

# El Gordo de la Primitiva Config
NUM_NUMBERS=5
NUM_KEY_RANGE=10
MAX_NUMBER=54

# External APIs
LOTTERY_API_URL="https://www.loteriasyapuestas.es"

# Cache
CACHE_TTL=3600
